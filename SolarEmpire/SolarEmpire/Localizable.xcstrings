          "stringUnit": {
            "state": "translated",
            "value": "Nå målet för att expandera till ett nytt land. Pengar, energi och uppgraderingar nollställs, men du behåller en permanent bonus på +30 % produktion för varje land."
          }
        }
      }
    },
